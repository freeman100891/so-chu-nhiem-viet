DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Chuyển /index.html về /
    RewriteCond %{THE_REQUEST} \s/+index\.html(?:[\s?]) [NC]
    RewriteRule ^index\.html$ / [R=301,L]

    # Không can thiệp file và thư mục có thật
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Nếu có backend API, không chuyển API về React
    RewriteRule ^api(?:/|$) - [L]

    # Chuyển tất cả route React về index.html
    RewriteRule ^ /index.html [L]
</IfModule>